# Names only. Set values in Vercel's encrypted environment settings, never this file.
# Canonical HTTPS origin, no trailing slash, path, credentials, query or fragment.
SITE_URL=
# Supabase transaction pooler connection; server-side only, prepare:false.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Independently generated, >=32 characters each.
SESSION_SECRET=
CRON_SECRET=
# Comma-separated published Chrome/Edge/Firefox identity IDs. Empty disables extension audience.
PLAINHAND_EXTENSION_IDS=
# Optional HTTPS support channel. Default is the public project issue tracker.
SUPPORT_URL=
# No Sentry integration is active. Do not add DSNs expecting automatic tracking.
# Hosted Sign in with ChatGPT remains disabled pending provider approval.
