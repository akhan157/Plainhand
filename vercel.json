{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "{plainhand/web/**,node_modules/@sparticuz/chromium/bin/**,node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 6 * * *"
    }
  ]
}
