{
  "manifest_version": 3,
  "name": "Plainhand",
  "short_name": "Plainhand",
  "version": "1.0.0",
  "description": "Save jobs to Plainhand, fill application pages with your approved answers, and record what you submitted. It never submits for you.",
  "homepage_url": "https://plainhand-cloud.vercel.app",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "options_ui": {
    "page": "popup/popup.html#account",
    "open_in_tab": false
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "identity"
  ],
  "optional_host_permissions": [
    "https://*.greenhouse.io/*",
    "https://*.lever.co/*",
    "https://boards.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "https://*.ashbyhq.com/*",
    "https://*.workday.com/*",
    "https://*.smartrecruiters.com/*",
    "https://*.workable.com/*",
    "https://*.recruitee.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "web_accessible_resources": [],
  "action": {
    "default_title": "Plainhand",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
